{
  "name": "kanban-sauce",
  "displayName": "Kanban Sauce",
  "description": "A flexible, local-first Kanban board for your editor. Manage projects, tasks, notes, and ideas with Markdown files you own and version-control.",
  "version": "2.1.0",
  "packageManager": "pnpm@11.20.0",
  "publisher": "salsa-lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/salsa-lab/kanban-sauce"
  },
  "bugs": {
    "url": "https://github.com/salsa-lab/kanban-sauce/issues"
  },
  "homepage": "https://github.com/salsa-lab/kanban-sauce#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Notebooks"
  ],
  "keywords": [
    "kanban",
    "kanban board",
    "board",
    "markdown",
    "project management",
    "task management",
    "markdown kanban",
    "project planning",
    "productivity",
    "local first",
    "local first kanban",
    "notes",
    "vscode",
    "cursor",
    "vscodium",
    "todo",
    "backlog",
    "agile",
    "scrum",
    "trello",
    "notion",
    "obsidian",
    "planner",
    "issue tracker",
    "roadmap"
  ],
  "activationEvents": [
    "onWebviewPanel:kanban-sauce.panel",
    "onView:kanban-sauce.boardView"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "json",
        "filenames": [
          ".kanbansauce"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".kanbansauce",
        "url": "./resources/kanbansauce.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kanban-sauce",
          "title": "%viewContainer.title%",
          "icon": "resources/icon_128.png"
        }
      ]
    },
    "views": {
      "kanban-sauce": [
        {
          "id": "kanban-sauce.boardView",
          "name": "%view.board.name%",
          "type": "webview"
        },
        {
          "id": "kanban-sauce.inProgressView",
          "name": "Cards"
        },
        {
          "id": "kanban-sauce.boardsView",
          "name": "Available Boards"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kanban-sauce.boardsView",
        "contents": "%viewsWelcome.boardsView%"
      },
      {
        "view": "kanban-sauce.inProgressView",
        "contents": "%viewsWelcome.inProgressView.noBoard%",
        "when": "!kanban-sauce.activeBoard"
      },
      {
        "view": "kanban-sauce.inProgressView",
        "contents": "%viewsWelcome.inProgressView.emptyColumn%",
        "when": "kanban-sauce.activeBoard"
      }
    ],
    "commands": [
      {
        "command": "kanban-sauce.open",
        "title": "%command.open.title%",
        "category": "%command.category%",
        "icon": {
          "light": "resources/icon.png",
          "dark": "resources/icon.png"
        }
      },
      {
        "command": "kanban-sauce.addFeature",
        "title": "%command.addFeature.title%",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.openDirectory",
        "title": "%command.openDirectory.title%",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.openBoardFromTree",
        "title": "Open Board",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.openFeatureFromTree",
        "title": "Open Card",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortByName",
        "title": "Sort by: Name",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortByName.checked",
        "title": "✓ Sort by: Name",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortByModified",
        "title": "Sort by: Last Modified",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortByModified.checked",
        "title": "✓ Sort by: Last Modified",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortByName",
        "title": "Sort by: Name",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortByName.checked",
        "title": "✓ Sort by: Name",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortByModified",
        "title": "Sort by: Last Modified",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortByModified.checked",
        "title": "✓ Sort by: Last Modified",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortAscending",
        "title": "Sort Direction: Ascending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortAscending.checked",
        "title": "✓ Sort Direction: Ascending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortDescending",
        "title": "Sort Direction: Descending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.boards.sortDescending.checked",
        "title": "✓ Sort Direction: Descending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortAscending",
        "title": "Sort Direction: Ascending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortAscending.checked",
        "title": "✓ Sort Direction: Ascending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortDescending",
        "title": "Sort Direction: Descending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.inProgress.sortDescending.checked",
        "title": "✓ Sort Direction: Descending",
        "category": "%command.category%"
      },
      {
        "command": "kanban-sauce.changeSidebarColumn",
        "title": "Filter Sidebar Cards by Column",
        "category": "%command.category%",
        "icon": "$(filter)"
      },
      {
        "command": "kanban-sauce.boards.renameBoard",
        "title": "Rename Board",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "kanban-sauce.boards.removeBoard",
        "title": "Remove from History",
        "category": "%command.category%",
        "icon": "$(trash)"
      }
    ],
    "configuration": [
      {
        "title": "%config.workflow.title%",
        "order": 1,
        "properties": {
          "kanban-sauce.defaultStatus": {
            "type": "string",
            "default": "backlog",
            "order": 1,
            "enum": [
              "backlog",
              "todo",
              "in-progress",
              "review",
              "done"
            ],
            "enumDescriptions": [
              "%config.defaultStatus.backlog%",
              "%config.defaultStatus.todo%",
              "%config.defaultStatus.inProgress%",
              "%config.defaultStatus.review%",
              "%config.defaultStatus.done%"
            ],
            "markdownDescription": "%config.defaultStatus.description%"
          },
          "kanban-sauce.defaultPriority": {
            "type": "string",
            "default": "medium",
            "order": 2,
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "enumDescriptions": [
              "%config.defaultPriority.critical%",
              "%config.defaultPriority.high%",
              "%config.defaultPriority.medium%",
              "%config.defaultPriority.low%"
            ],
            "markdownDescription": "%config.defaultPriority.description%"
          },
          "kanban-sauce.addNewCardsToTop": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "markdownDescription": "%config.addNewCardsToTop.description%"
          },
          "kanban-sauce.filenamePattern": {
            "type": "string",
            "default": "name-date",
            "order": 4,
            "enum": [
              "name-date",
              "date-name",
              "name-datetime",
              "datetime-name"
            ],
            "enumDescriptions": [
              "%config.filenamePattern.nameDate%",
              "%config.filenamePattern.dateName%",
              "%config.filenamePattern.nameDatetime%",
              "%config.filenamePattern.datetimeName%"
            ],
            "markdownDescription": "%config.filenamePattern.description%"
          },
          "kanban-sauce.columns": {
            "type": "array",
            "order": 5,
            "default": [
              {
                "id": "backlog",
                "name": "Backlog",
                "color": "#6b7280"
              },
              {
                "id": "todo",
                "name": "To Do",
                "color": "#3b82f6"
              },
              {
                "id": "in-progress",
                "name": "In Progress",
                "color": "#f59e0b"
              },
              {
                "id": "review",
                "name": "Review",
                "color": "#8b5cf6"
              },
              {
                "id": "done",
                "name": "Done",
                "color": "#22c55e"
              }
            ],
            "markdownDescription": "%config.columns.description%",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "%config.columns.id.description%"
                },
                "name": {
                  "type": "string",
                  "description": "%config.columns.name.description%"
                },
                "color": {
                  "type": "string",
                  "description": "%config.columns.color.description%"
                }
              },
              "required": [
                "id",
                "name",
                "color"
              ]
            }
          },
          "kanban-sauce.markdownEditorMode": {
            "type": "boolean",
            "default": false,
            "order": 6,
            "markdownDescription": "%config.markdownEditorMode.description%"
          },
          "kanban-sauce.defaultEditorMode": {
            "type": "string",
            "enum": [
              "rich-text",
              "raw"
            ],
            "default": "rich-text",
            "order": 7,
            "markdownDescription": "%config.defaultEditorMode.description%"
          },
          "kanban-sauce.showLineNumbersInRawMode": {
            "type": "boolean",
            "default": true,
            "order": 8,
            "markdownDescription": "%config.showLineNumbersInRawMode.description%"
          },
          "kanban-sauce.language": {
            "type": "string",
            "default": "auto",
            "order": 9,
            "enum": [
              "auto",
              "en",
              "es",
              "pt"
            ],
            "enumDescriptions": [
              "%config.language.auto%",
              "%config.language.en%",
              "%config.language.es%",
              "%config.language.pt%"
            ],
            "markdownDescription": "%config.language.description%"
          }
        }
      },
      {
        "title": "%config.appearance.title%",
        "order": 2,
        "properties": {
          "kanban-sauce.compactMode": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "markdownDescription": "%config.compactMode.description%"
          },
          "kanban-sauce.showPriorityBadges": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "%config.showPriorityBadges.description%"
          },
          "kanban-sauce.showAssignee": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "markdownDescription": "%config.showAssignee.description%"
          },
          "kanban-sauce.showDueDate": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "markdownDescription": "%config.showDueDate.description%"
          },
          "kanban-sauce.showLabels": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "markdownDescription": "%config.showLabels.description%"
          },
          "kanban-sauce.showEpic": {
            "type": "boolean",
            "default": true,
            "order": 6,
            "markdownDescription": "%config.showEpic.description%"
          },
          "kanban-sauce.showFileName": {
            "type": "boolean",
            "default": false,
            "order": 7,
            "markdownDescription": "%config.showFileName.description%"
          },
          "kanban-sauce.hideScrollbar": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "markdownDescription": "%config.hideScrollbar.description%"
          },
          "kanban-sauce.editorToolbarHeight": {
            "type": "number",
            "default": 32,
            "order": 9,
            "markdownDescription": "%config.editorToolbarHeight.description%"
          }
        }
      },
      {
        "title": "%config.typography.title%",
        "order": 3,
        "properties": {
          "kanban-sauce.fontSizeColumnHeader": {
            "type": "string",
            "default": "16px",
            "order": 1,
            "markdownDescription": "%config.fontSizeColumnHeader.description%"
          },
          "kanban-sauce.fontSizeCardTitle": {
            "type": "string",
            "default": "14px",
            "order": 2,
            "markdownDescription": "%config.fontSizeCardTitle.description%"
          },
          "kanban-sauce.fontSizeCardDescription": {
            "type": "string",
            "default": "14px",
            "order": 3,
            "markdownDescription": "%config.fontSizeCardDescription.description%"
          },
          "kanban-sauce.fontSizeCardLabel": {
            "type": "string",
            "default": "12px",
            "order": 4,
            "markdownDescription": "%config.fontSizeCardLabel.description%"
          },
          "kanban-sauce.fontSizeCardMeta": {
            "type": "string",
            "default": "13px",
            "order": 5,
            "markdownDescription": "%config.fontSizeCardMeta.description%"
          },
          "kanban-sauce.fontSizeEditorHeader": {
            "type": "string",
            "default": "18px",
            "order": 6,
            "markdownDescription": "%config.fontSizeEditorHeader.description%"
          },
          "kanban-sauce.fontSizeEditorBody": {
            "type": "string",
            "default": "16px",
            "order": 7,
            "markdownDescription": "%config.fontSizeEditorBody.description%"
          },
          "kanban-sauce.fontSizeEditorMeta": {
            "type": "string",
            "default": "14px",
            "order": 8,
            "markdownDescription": "%config.fontSizeEditorMeta.description%"
          }
        }
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "kanban-sauce.openDirectory",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kanban-sauce.openBoardFromTree",
          "when": "false"
        },
        {
          "command": "kanban-sauce.openFeatureFromTree",
          "when": "false"
        },
        {
          "command": "kanban-sauce.openDirectory",
          "when": "false"
        },
        {
          "command": "kanban-sauce.changeSidebarColumn",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.renameBoard",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.removeBoard",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortByName",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortByName.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortByModified",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortByModified.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortAscending",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortAscending.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortDescending",
          "when": "false"
        },
        {
          "command": "kanban-sauce.boards.sortDescending.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortByName",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortByName.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortByModified",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortByModified.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortAscending",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortAscending.checked",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortDescending",
          "when": "false"
        },
        {
          "command": "kanban-sauce.inProgress.sortDescending.checked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "kanban-sauce.boards.sortByName",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSort != 'name'",
          "group": "1_sort@1"
        },
        {
          "command": "kanban-sauce.boards.sortByName.checked",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSort == 'name'",
          "group": "1_sort@1"
        },
        {
          "command": "kanban-sauce.boards.sortByModified",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSort != 'modified'",
          "group": "1_sort@2"
        },
        {
          "command": "kanban-sauce.boards.sortByModified.checked",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSort == 'modified'",
          "group": "1_sort@2"
        },
        {
          "command": "kanban-sauce.boards.sortAscending",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSortDir != 'asc'",
          "group": "2_sortDir@1"
        },
        {
          "command": "kanban-sauce.boards.sortAscending.checked",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSortDir == 'asc'",
          "group": "2_sortDir@1"
        },
        {
          "command": "kanban-sauce.boards.sortDescending",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSortDir != 'desc'",
          "group": "2_sortDir@2"
        },
        {
          "command": "kanban-sauce.boards.sortDescending.checked",
          "when": "view == kanban-sauce.boardsView && kanban-sauce.boardsSortDir == 'desc'",
          "group": "2_sortDir@2"
        },
        {
          "command": "kanban-sauce.inProgress.sortByName",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSort != 'name'",
          "group": "1_sort@1"
        },
        {
          "command": "kanban-sauce.inProgress.sortByName.checked",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSort == 'name'",
          "group": "1_sort@1"
        },
        {
          "command": "kanban-sauce.inProgress.sortByModified",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSort != 'modified'",
          "group": "1_sort@2"
        },
        {
          "command": "kanban-sauce.inProgress.sortByModified.checked",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSort == 'modified'",
          "group": "1_sort@2"
        },
        {
          "command": "kanban-sauce.inProgress.sortAscending",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSortDir != 'asc'",
          "group": "2_sortDir@1"
        },
        {
          "command": "kanban-sauce.inProgress.sortAscending.checked",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSortDir == 'asc'",
          "group": "2_sortDir@1"
        },
        {
          "command": "kanban-sauce.inProgress.sortDescending",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSortDir != 'desc'",
          "group": "2_sortDir@2"
        },
        {
          "command": "kanban-sauce.inProgress.sortDescending.checked",
          "when": "view == kanban-sauce.inProgressView && kanban-sauce.inProgressSortDir == 'desc'",
          "group": "2_sortDir@2"
        },
        {
          "command": "kanban-sauce.changeSidebarColumn",
          "when": "view == kanban-sauce.inProgressView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kanban-sauce.boards.renameBoard",
          "when": "view == kanban-sauce.boardsView && viewItem == boardItem",
          "group": "1_actions"
        },
        {
          "command": "kanban-sauce.boards.removeBoard",
          "when": "view == kanban-sauce.boardsView && viewItem == boardItem",
          "group": "1_actions"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build:webview": "vite build",
    "watch": "concurrently \"pnpm run watch:extension\" \"pnpm run watch:webview\"",
    "watch:extension": "esbuild src/extension/index.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "watch:webview": "vite build --watch",
    "dev": "pnpm run watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage",
    "build:integration": "tsc --project tsconfig.integration.json",
    "test:integration": "pnpm run build:integration && node out/tests/integration/runTests.js",
    "prepackage": "node -e \"require('fs').mkdirSync('releases', {recursive: true})\"",
    "package": "vsce package --no-dependencies -o releases/",
    "check-l10n": "pnpm exec tsx scripts/check-l10n.ts",
    "release": "tsx scripts/release.ts",
    "release:patch": "tsx scripts/release.ts patch",
    "release:minor": "tsx scripts/release.ts minor",
    "release:major": "tsx scripts/release.ts major"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "~4.0.18",
